# ==============================================================
# TecnoStore / Distribuidora Central — Variables de Entorno
# ==============================================================
# En Vercel: copiá estas variables en Project Settings > Environment Variables.
# En desarrollo local: copiá este archivo como `.env`.
# ==============================================================

# --------------------------------------------------------------
# 1. BASE DE DATOS (PostgreSQL / Supabase para producción en Vercel)
# --------------------------------------------------------------
# Obtené la cadena de conexión en Supabase:
# Project Settings > Database > Connection string > URI (Transaction pooler o Session pooler, puerto 6543 o 5432)
# Ejemplo:
# DATABASE_URL=postgresql://postgres.[project-ref]:[tu-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Fallback para desarrollo local con SQLite si DATABASE_URL no está definido:
DATABASE_PATH=data/app.db

# --------------------------------------------------------------
# 2. SUPABASE STORAGE (Persistencia de imágenes en producción)
# --------------------------------------------------------------
# Obtené estos valores en Supabase: Project Settings > API
# SUPABASE_URL: URL del proyecto (ej: https://xyzcompany.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY: Clave secreta service_role (permite crear buckets y subir archivos)
# SUPABASE_ANON_KEY: Clave pública anon (alternativa)
# SUPABASE_STORAGE_BUCKET: Nombre del bucket público (por defecto 'uploads')
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Fallback de imágenes en disco local (solo usado en desarrollo local sin Supabase):
UPLOAD_DIR=data/uploads

# --------------------------------------------------------------
# 3. AUTENTICACIÓN Y SEGURIDAD
# --------------------------------------------------------------
# Secreto criptográfico para firmar los tokens JWT de sesión del panel (/admin).
# OBLIGATORIO en Vercel y producción.
# Generá uno seguro con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio

# --------------------------------------------------------------
# 4. ADMINISTRADOR INICIAL (Para la primera inicialización de la BD)
# --------------------------------------------------------------
# La aplicación crea este usuario en la base de datos con contraseña hasheada (bcrypt).
# Al ingresar por primera vez, el sistema exige cambiar la contraseña.
ADMIN_INITIAL_USER=admin
ADMIN_INITIAL_PASSWORD=Admin2026!
