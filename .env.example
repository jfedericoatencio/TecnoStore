# ==============================================================
# Distribuidora Central — Variables de entorno
# Copiá este archivo como `.env` y completá los valores.
# ==============================================================

# Ruta del archivo de base de datos (SQLite en desarrollo).
# Para producción con PostgreSQL/Supabase, escribí la cadena de conexión.
DATABASE_PATH=data/app.db

# Secreto para firmar los JWT de sesión del panel de administración.
# Generá uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio

# Carpeta donde se guardan las imágenes subidas desde el panel.
UPLOAD_DIR=data/uploads

# Credenciales del administrador inicial (SOLO las usa el script de seed
# del servidor: `npm run db:seed`. Nunca se exponen al frontend).
ADMIN_INITIAL_USER=admin
ADMIN_INITIAL_PASSWORD=Admin2026!
